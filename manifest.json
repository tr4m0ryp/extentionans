{
  "manifest_version": 3,
  "name": "UvA Tweaks",
  "version": "1.2.0",
  "description": "Makes ans.uva.nl look unreachable, and hides OVV-1 announcements on Canvas.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.ans.uva.nl/*"],
      "js": ["src/ans/pages/chrome.js", "src/ans/pages/edge.js", "src/ans/block.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://canvas.uva.nl/*"],
      "js": [
        "src/canvas/config.js",
        "src/canvas/store.js",
        "src/canvas/css.js",
        "src/canvas/api.js",
        "src/canvas/home.js",
        "src/canvas/index_page.js",
        "src/canvas/topic.js",
        "src/canvas/main.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
