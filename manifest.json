{
  "manifest_version": 3,
  "name": "pdfextention",
  "version": "1.3.0",
  "description": "Extract and export text from PDF files.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ans.uva.nl/*"
      ],
      "js": [
        "src/ans/pages/chrome.js",
        "src/ans/pages/edge.js",
        "src/ans/block.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://canvas.uva.nl/*"
      ],
      "js": [
        "src/canvas/config.js",
        "src/canvas/store.js",
        "src/canvas/css.js",
        "src/canvas/api.js",
        "src/canvas/home.js",
        "src/canvas/index_page.js",
        "src/canvas/topic.js",
        "src/canvas/discussions.js",
        "src/canvas/main.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
